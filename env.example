# Required API Keys
TRANSPOSE_API_KEY=your_transpose_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional Configuration
RPC_URL=https://ethereum.therpc.io
OPENAI_BASE_URL=https://api.openai.com/v1

# Token Management (Optional)
# Maximum tokens for LLM analysis input
# Adjust based on model context limits and cost considerations
# Default: 25000 for gpt-4o, 20000 for gpt-4o-mini, 8000 for gpt-3.5-turbo
# MAX_ANALYSIS_TOKENS=25000

# Optional Simulation Services
TENDERLY_API_KEY=your_tenderly_api_key_here
TENDERLY_ACCOUNT_ID=your_tenderly_account_id_here
TENDERLY_PROJECT_SLUG=your_tenderly_project_slug_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit your .env file to version control 